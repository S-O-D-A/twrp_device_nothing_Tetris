import /init.recovery.project.rc

on init
    setprop sys.usb.configfs 1
    setprop sys.usb.controller "11201000.usb0"
    setprop sys.usb.ffs.aio_compat 1
    setprop persist.sys.usb.config adb
    setprop sys.usb.config adb
    setprop orangefox.vendor_boot.recovery true
    mkdir /dev/block/bootdevice 0755 root root
    symlink /dev/block/by-name /dev/block/bootdevice/by-name

on boot
    insmod /vendor/lib/modules/mtk_disp_notify.ko
    insmod /vendor/lib/modules/mediatek-drm-panel-drv.ko
    insmod /vendor/lib/modules/bootinfo.ko
    insmod /vendor/lib/modules/touchpanel_event_notify.ko
    insmod /vendor/lib/modules/focaltech_tp.ko
    insmod /vendor/lib/modules/hbt.ko

on fs && property:ro.debuggable=0
    start adbd

# Keep ADB alive; OrangeFox MTP switching breaks USB gadget on Tetris
on property:sys.usb.config=mtp
    setprop sys.usb.config adb

on property:sys.usb.config=mtp,adb
    setprop sys.usb.config adb

on property:persist.sys.usb.config=mtp
    setprop persist.sys.usb.config adb

on property:persist.sys.usb.config=mtp,adb
    setprop persist.sys.usb.config adb
